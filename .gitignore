# AWS credentials file
.env

# Terraform working directory (provider binaries, 100MB+)
.terraform/

# State files: contain resource IDs and sometimes SECRETS in plain text
*.tfstate
*.tfstate.*

# Variable files often hold passwords or account-specific values
.tfvars
!example.tfvars

backend.hcl
# Local override files (can be ignored as they are usually machine-specific)
*.tfplan

